{
  "background": {
    "scripts": [
      "ai.js",
      "definitions.js",
      "matcher.js",
      "timeline.js",
      "follows.js",
      "worker-host.js",
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Highlightext",
    "default_panel": "popup.html?sidebar=1",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "highlightext@highlightext.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "personalCommunications"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ]
}
